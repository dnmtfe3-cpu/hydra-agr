{
  "name": "hydra-agro-mobile",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Aplicativo mobile Hydra Agro para gestão rural, hídrica, animal e tecnológica.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run lint && vite build",
    "build:android": "npm run env:check && npm run build",
    "env:check": "node scripts/check-build-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#174c36' --iconBackgroundColorDark '#174c36' --splashBackgroundColor '#174c36' --splashBackgroundColorDark '#174c36'",
    "android:add": "cap add android",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-nfc": "^8.2.2",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.18"
  }
}
